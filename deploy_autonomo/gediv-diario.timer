[Unit]
Description=Agendamento em dias úteis do Observatório GEDIV (Seg-Sex, 09:00 e 14:00 America/Sao_Paulo)

[Timer]
# Execução estritamente de segunda a sexta-feira (nunca sábados ou domingos)
OnCalendar=Mon..Fri *-*-* 09:00:00 America/Sao_Paulo
OnCalendar=Mon..Fri *-*-* 14:00:00 America/Sao_Paulo
# Recupera disparos perdidos após indisponibilidade do host; o próprio script
# rodar_diario.sh bloqueia execução se o dia local atual for sábado ou domingo.
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
