# Modelo de configuração de ambiente para /etc/gediv/admin.env (permissão recomendada: chmod 640, root:gediv)
# Não versionar segredos reais no Git.

# Modo de produção endurecido (obrigatório sob --modo-producao no gediv-admin.service;
# desabilitar qualquer uma das 5 proteções abaixo aborta a inicialização de forma segura):
GEDIV_MODO_PRODUCAO=1
GEDIV_COOKIE_SECURE=1
GEDIV_LOGIN_SOMENTE_COOKIE=1
GEDIV_EXIGIR_SNAPSHOT_PUBLICO=1

# Credencial técnica legada DESABILITADA por padrão em produção (autenticação exclusiva por contas nominais):
GEDIV_HABILITAR_TOKEN_TECNICO=0
# GEDIV_TOKEN_GERENCIA=

# Origens CORS extras (vazio por padrão, pois o painel unificado é servido na mesma origem):
# GEDIV_ORIGENS_ADMIN=
